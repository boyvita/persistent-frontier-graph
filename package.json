{
  "name": "persistent-frontier-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synchronized persistent-frontier layouts for expandable trees in React.",
  "author": "Vitaly Boytsov (https://github.com/boyvita)",
  "license": "MIT",
  "homepage": "https://boyvita.github.io/persistent-frontier-graph/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyvita/persistent-frontier-graph.git"
  },
  "bugs": {
    "url": "https://github.com/boyvita/persistent-frontier-graph/issues"
  },
  "keywords": [
    "tree",
    "graph",
    "react",
    "visualization",
    "radial-tree",
    "mind-map",
    "frontier"
  ],
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./dist-lib/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:demo",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:package",
    "check:all": "npm run check && npm run test:browser",
    "preview": "vite preview",
    "prepare": "npm run build:library",
    "prepublishOnly": "node -e \"throw new Error('npm publication is intentionally disabled; install from GitHub.')\""
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0"
  }
}
